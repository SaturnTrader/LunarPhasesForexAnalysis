# Configuración para LunarPhasesForexAnalysis
# Edita estos valores según tu setup

# Rutas generales
EPHE_PATH=data/lunar_data/swisseph_dll
DLL_PATH=data/lunar_data/swisseph_dll

# Datos financieros
FINANCIAL_DATA_PATH=data/interim/financial
FINANCIAL_DATA_TIMEZONE=EST  # EST fijo (UTC-5 sin DST) para histdata.com; cambia a 'UTC' si usas otra fuente
HISTDATA_RAW_PATH=data/financial_data/raw  # Carpeta para CSVs anuales raw de histdata
OUTPUT_DIR=data/processed  # Directorio para archivos generados / resultados

# Pares de divisas (lista separada por comas)
PAIRS=AUDUSD,EURCHF,EURGBP,EURJPY,GBPUSD,USDCAD,USDCHF,USDHKD,USDJPY,USDMXN

# Rango de análisis
START_DATE=2018-01-01
END_DATE=2024-12-31

# Períodos pandémicos
PRE_PANDEMIC_END=2020-03-01
PANDEMIC_END=2021-12-31

# Opciones de procesamiento
CLIP_OUTLIERS=True  # Filtrar retornos extremos (quantiles 1%-99%)

# Notas:
# - PAIRS: Lista de pares de divisas, separados por comas, sin espacios (ej: AUDUSD,EURUSD,USDJPY).
# - Para Swiss Ephemeris: Verifica paths en Windows/Linux.
# - Timezone: EST para histdata; prueba con logs de timestamps para validar.
# - Si cambias fuente de datos, solo edita FINANCIAL_DATA_TIMEZONE y FINANCIAL_DATA_PATH.